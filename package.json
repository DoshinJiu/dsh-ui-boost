{
  "name": "dsh-ui-boost",
  "version": "0.5.5",
  "description": "DSH Web 界面增强：QQ 聊天模式（气泡+联系人侧栏）、RGB 调色、Tool 卡片折叠、输入区状态条（含 token 估算）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "theme"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
